#!/bin/bash
# omakasui:summary=Generate themed preview-unlock.png previews for all themes
# omakasui:args=<themes directory (f.e. ~/.local/share/omakub/themes)>

set -euo pipefail

SCRIPT_DIR=$(cd -- "$(dirname -- "$(readlink -f -- "${BASH_SOURCE[0]}")")" && pwd)
source "$SCRIPT_DIR/lib/theme-colors.sh"

if [[ $# -ne 1 ]]; then
  echo "Usage: ${OMAKASUI_PROG_NAME:-$(basename -- "$0")} theme generate preview <themes directory>" >&2
  exit 1
fi

THEMES_DIR="$1"
OUTPUT_FILE="preview-unlock.png"
CANVAS_W=1920
CANVAS_H=1080

for theme_dir in "$THEMES_DIR"/*/; do
  theme_name=$(basename "$theme_dir")
  colors_file="$theme_dir/colors.toml"
  unlock_png="$theme_dir/unlock.png"

  [[ -f $colors_file ]] || { echo "Skipping $theme_name: no colors.toml"; continue; }
  [[ -f $unlock_png ]] || { echo "Skipping $theme_name: no unlock.png"; continue; }

  theme_read_colors "$colors_file" "$theme_name" || continue

  echo "Generating $theme_name/$OUTPUT_FILE (accent=#$THEME_ACCENT bg=#$THEME_BACKGROUND)"
  theme_composite_centered "$THEME_BACKGROUND" "$unlock_png" "$CANVAS_W" "$CANVAS_H" "$theme_dir/$OUTPUT_FILE"
done
